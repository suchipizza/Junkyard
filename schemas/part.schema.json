{
  "$comment": "Generated by `python -m junkyard.models.export`. Do not hand-edit.",
  "$defs": {
    "Datasheet": {
      "additionalProperties": false,
      "properties": {
        "retrieved": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "url": {
          "anyOf": [
            {
              "pattern": "^https?://\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "title": "Datasheet",
      "type": "object"
    },
    "Frame": {
      "additionalProperties": false,
      "description": "Port frame: origin in mm plus right-handed unit z and x axes.",
      "properties": {
        "origin_mm": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Origin Mm",
          "type": "array"
        },
        "x_axis": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "X Axis",
          "type": "array"
        },
        "z_axis": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Z Axis",
          "type": "array"
        }
      },
      "required": [
        "origin_mm",
        "z_axis",
        "x_axis"
      ],
      "title": "Frame",
      "type": "object"
    },
    "Gender": {
      "enum": [
        "male",
        "female",
        "neutral"
      ],
      "title": "Gender",
      "type": "string"
    },
    "Port": {
      "additionalProperties": false,
      "description": "A named, typed connection point with a frame (PRD 5.3).",
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "frame": {
          "$ref": "#/$defs/Frame"
        },
        "gender": {
          "$ref": "#/$defs/Gender"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "params": {
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "title": "Params",
          "type": "object"
        },
        "params_from": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Name of a part_ref param whose part supplies port params.",
          "title": "Params From"
        },
        "type": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "name",
        "type",
        "gender",
        "frame"
      ],
      "title": "Port",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "Where a value or claim comes from (PRD 5.4).",
      "properties": {
        "kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Page, table or section inside the source.",
          "title": "Location"
        },
        "retrieved": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "url": {
          "anyOf": [
            {
              "pattern": "^https?://\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Source",
      "type": "object"
    },
    "SourceKind": {
      "enum": [
        "datasheet",
        "reference_drawing",
        "standard",
        "web",
        "literature"
      ],
      "title": "SourceKind",
      "type": "string"
    },
    "SpecValue": {
      "additionalProperties": false,
      "description": "One spec value with its source and verification state.\n\nExtra keys starting with ``at_`` record the conditions a value holds under,\ne.g. ``at_voltage_v`` for a stall torque.",
      "patternProperties": {
        "^at_[a-z][a-z0-9_]*$": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "properties": {
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/Source"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "verification": {
          "$ref": "#/$defs/Verification",
          "default": "unverified"
        }
      },
      "required": [
        "value",
        "source"
      ],
      "title": "SpecValue",
      "type": "object"
    },
    "Verification": {
      "enum": [
        "unverified",
        "datasheet"
      ],
      "title": "Verification",
      "type": "string"
    }
  },
  "$id": "https://github.com/suchipizza/Junkyard/blob/main/schemas/part.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "aliases": {
      "items": {
        "type": "string"
      },
      "title": "Aliases",
      "type": "array"
    },
    "class": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Actuator class from vocab/actuator_classes.yaml; null for non-actuators.",
      "title": "Class"
    },
    "datasheets": {
      "items": {
        "$ref": "#/$defs/Datasheet"
      },
      "title": "Datasheets",
      "type": "array"
    },
    "id": {
      "pattern": "^part\\.[a-z][a-z0-9_]*\\.[a-z0-9][a-z0-9_]*$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "ports": {
      "items": {
        "$ref": "#/$defs/Port"
      },
      "title": "Ports",
      "type": "array"
    },
    "schema_version": {
      "enum": [
        "0.2.0"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "specs": {
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "$ref": "#/$defs/SpecValue"
        }
      },
      "title": "Specs",
      "type": "object"
    },
    "updated_at": {
      "format": "date",
      "title": "Updated At",
      "type": "string"
    },
    "variance_note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Variance Note"
    },
    "where_to_buy": {
      "description": "Generic search terms only; no affiliate links in v1.",
      "items": {
        "type": "string"
      },
      "title": "Where To Buy",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "updated_at",
    "id",
    "name"
  ],
  "title": "Junkyard part record",
  "type": "object",
  "x-junkyard-schema-version": "0.2.0"
}
