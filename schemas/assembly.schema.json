{
  "$comment": "Generated by `python -m junkyard.models.export`. Do not hand-edit.",
  "$defs": {
    "AssemblyItem": {
      "additionalProperties": false,
      "properties": {
        "brick": {
          "pattern": "^[a-z][a-z0-9_]*\\.[a-z0-9][a-z0-9_]*$",
          "title": "Brick",
          "type": "string"
        },
        "key": {
          "description": "Instance name, unique within the assembly.",
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Key",
          "type": "string"
        },
        "params": {
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "string"
                }
              ]
            }
          },
          "title": "Params",
          "type": "object"
        },
        "part_refs": {
          "description": "Resolved part for each part_ref param.",
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "pattern": "^part\\.[a-z][a-z0-9_]*\\.[a-z0-9][a-z0-9_]*$",
              "type": "string"
            }
          },
          "title": "Part Refs",
          "type": "object"
        },
        "version": {
          "description": "Library version the brick came from.",
          "pattern": "^\\d+\\.\\d+\\.\\d+([.+-][0-9A-Za-z.+-]+)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "key",
        "brick",
        "version"
      ],
      "title": "AssemblyItem",
      "type": "object"
    },
    "BomRollupLine": {
      "additionalProperties": false,
      "properties": {
        "from_items": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "From Items",
          "type": "array"
        },
        "part": {
          "pattern": "^part\\.[a-z][a-z0-9_]*\\.[a-z0-9][a-z0-9_]*$",
          "title": "Part",
          "type": "string"
        },
        "qty": {
          "minimum": 1,
          "title": "Qty",
          "type": "integer"
        }
      },
      "required": [
        "part",
        "qty"
      ],
      "title": "BomRollupLine",
      "type": "object"
    },
    "Connection": {
      "additionalProperties": false,
      "properties": {
        "a": {
          "$ref": "#/$defs/PortRef"
        },
        "b": {
          "$ref": "#/$defs/PortRef"
        },
        "transform": {
          "anyOf": [
            {
              "$ref": "#/$defs/Transform"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "a",
        "b"
      ],
      "title": "Connection",
      "type": "object"
    },
    "PortRef": {
      "additionalProperties": false,
      "properties": {
        "item": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Item",
          "type": "string"
        },
        "port": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Port",
          "type": "string"
        }
      },
      "required": [
        "item",
        "port"
      ],
      "title": "PortRef",
      "type": "object"
    },
    "Transform": {
      "additionalProperties": false,
      "description": "Pose of connection side ``b`` relative to side ``a``, from the port frames.\n\n``matrix`` is a 4x4 homogeneous transform, row-major, translation in mm.",
      "properties": {
        "matrix": {
          "maxItems": 16,
          "minItems": 16,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Matrix",
          "type": "array"
        }
      },
      "required": [
        "matrix"
      ],
      "title": "Transform",
      "type": "object"
    }
  },
  "$id": "https://github.com/suchipizza/Junkyard/blob/main/schemas/assembly.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bom": {
      "items": {
        "$ref": "#/$defs/BomRollupLine"
      },
      "title": "Bom",
      "type": "array"
    },
    "catalog_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Catalog Hash",
      "type": "string"
    },
    "connections": {
      "items": {
        "$ref": "#/$defs/Connection"
      },
      "title": "Connections",
      "type": "array"
    },
    "disclaimer": {
      "const": "Generated geometry is not verified for printability, fit or strength. Check before printing.",
      "default": "Generated geometry is not verified for printability, fit or strength. Check before printing.",
      "title": "Disclaimer",
      "type": "string"
    },
    "format": {
      "const": "junkyard.assembly",
      "default": "junkyard.assembly",
      "title": "Format",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/AssemblyItem"
      },
      "minItems": 1,
      "title": "Items",
      "type": "array"
    },
    "library_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+([.+-][0-9A-Za-z.+-]+)?$",
      "title": "Library Version",
      "type": "string"
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    },
    "schema_version": {
      "enum": [
        "0.2.0"
      ],
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "library_version",
    "catalog_hash",
    "items"
  ],
  "title": "Junkyard assembly.json",
  "type": "object",
  "x-junkyard-schema-version": "0.2.0"
}
