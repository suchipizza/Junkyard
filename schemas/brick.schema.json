{
  "$comment": "Generated by `python -m junkyard.models.export`. Do not hand-edit.",
  "$defs": {
    "Actuation": {
      "additionalProperties": false,
      "properties": {
        "accepts_classes": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Accepts Classes",
          "type": "array"
        },
        "default_part": {
          "anyOf": [
            {
              "pattern": "^part\\.[a-z][a-z0-9_]*\\.[a-z0-9][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Part"
        }
      },
      "required": [
        "accepts_classes"
      ],
      "title": "Actuation",
      "type": "object"
    },
    "BomLine": {
      "additionalProperties": false,
      "properties": {
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "part": {
          "description": "A part id, or '@<param>' to use the part chosen by a param.",
          "title": "Part",
          "type": "string"
        },
        "qty": {
          "minimum": 1,
          "title": "Qty",
          "type": "integer"
        }
      },
      "required": [
        "part",
        "qty"
      ],
      "title": "BomLine",
      "type": "object"
    },
    "BrickLicense": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "const": "Apache-2.0",
          "default": "Apache-2.0",
          "title": "Code",
          "type": "string"
        },
        "data": {
          "const": "CC-BY-4.0",
          "default": "CC-BY-4.0",
          "title": "Data",
          "type": "string"
        }
      },
      "title": "BrickLicense",
      "type": "object"
    },
    "Derived": {
      "additionalProperties": false,
      "description": "An output agents can read without generating (``expr``) or that the build fills.",
      "properties": {
        "expr": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expr"
        },
        "from": {
          "anyOf": [
            {
              "const": "bbox",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/Unit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name"
      ],
      "title": "Derived",
      "type": "object"
    },
    "Difficulty": {
      "description": "Assembly effort.",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ],
      "title": "Difficulty",
      "type": "string"
    },
    "Frame": {
      "additionalProperties": false,
      "description": "Port frame: origin in mm plus right-handed unit z and x axes.",
      "properties": {
        "origin_mm": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Origin Mm",
          "type": "array"
        },
        "x_axis": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "X Axis",
          "type": "array"
        },
        "z_axis": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Z Axis",
          "type": "array"
        }
      },
      "required": [
        "origin_mm",
        "z_axis",
        "x_axis"
      ],
      "title": "Frame",
      "type": "object"
    },
    "Gender": {
      "enum": [
        "male",
        "female",
        "neutral"
      ],
      "title": "Gender",
      "type": "string"
    },
    "ImportedFile": {
      "additionalProperties": false,
      "properties": {
        "license": {
          "description": "SPDX identifier; must be in the allow-list (I8).",
          "title": "License",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "source_url": {
          "pattern": "^https?://\\S+$",
          "title": "Source Url",
          "type": "string"
        }
      },
      "required": [
        "path",
        "source_url",
        "license"
      ],
      "title": "ImportedFile",
      "type": "object"
    },
    "Mdi": {
      "additionalProperties": false,
      "properties": {
        "families": {
          "items": {
            "pattern": "^F(0[1-9]|1[0-8])$",
            "type": "string"
          },
          "title": "Families",
          "type": "array"
        },
        "realizes": {
          "pattern": "^mech\\.[a-z0-9][a-z0-9_]*$",
          "title": "Realizes",
          "type": "string"
        }
      },
      "required": [
        "realizes"
      ],
      "title": "Mdi",
      "type": "object"
    },
    "Origin": {
      "enum": [
        "original",
        "adapted",
        "imported"
      ],
      "title": "Origin",
      "type": "string"
    },
    "Param": {
      "additionalProperties": false,
      "properties": {
        "allowed_classes": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[a-z][a-z0-9_]*$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Classes"
        },
        "default": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Default"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "options": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Options"
        },
        "range": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Values for which the generator produces valid geometry (CI-enforced).",
          "title": "Range"
        },
        "type": {
          "$ref": "#/$defs/ParamType"
        },
        "unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/Unit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "type",
        "default"
      ],
      "title": "Param",
      "type": "object"
    },
    "ParamType": {
      "enum": [
        "float",
        "int",
        "bool",
        "enum",
        "part_ref",
        "material"
      ],
      "title": "ParamType",
      "type": "string"
    },
    "Port": {
      "additionalProperties": false,
      "description": "A named, typed connection point with a frame (PRD 5.3).",
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "frame": {
          "$ref": "#/$defs/Frame"
        },
        "gender": {
          "$ref": "#/$defs/Gender"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "params": {
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "title": "Params",
          "type": "object"
        },
        "params_from": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Name of a part_ref param whose part supplies port params.",
          "title": "Params From"
        },
        "type": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "name",
        "type",
        "gender",
        "frame"
      ],
      "title": "Port",
      "type": "object"
    },
    "PrintHints": {
      "additionalProperties": false,
      "description": "Recommendations only; nothing here is verified.",
      "properties": {
        "infill_percent": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Infill Percent"
        },
        "layer_height_mm": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Layer Height Mm"
        },
        "material": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9]*$",
            "type": "string"
          },
          "title": "Material",
          "type": "array"
        },
        "orientation": {
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "type": "string"
            }
          },
          "title": "Orientation",
          "type": "object"
        },
        "supports": {
          "anyOf": [
            {
              "$ref": "#/$defs/Supports"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "PrintHints",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "authors": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Authors",
          "type": "array"
        },
        "imported_files": {
          "items": {
            "$ref": "#/$defs/ImportedFile"
          },
          "title": "Imported Files",
          "type": "array"
        },
        "inspired_by": {
          "description": "Reference designs (ideas only).",
          "items": {
            "pattern": "^https?://\\S+$",
            "type": "string"
          },
          "title": "Inspired By",
          "type": "array"
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        }
      },
      "required": [
        "origin",
        "authors"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Stage": {
      "description": "Software maturity of code and docs (D12), not physical validation.",
      "enum": [
        "experimental",
        "beta",
        "stable"
      ],
      "title": "Stage",
      "type": "string"
    },
    "Supports": {
      "enum": [
        "none",
        "minimal",
        "required"
      ],
      "title": "Supports",
      "type": "string"
    },
    "Unit": {
      "enum": [
        "mm",
        "deg",
        "N·m",
        "N",
        "g",
        "V",
        "s",
        "rpm",
        "percent"
      ],
      "title": "Unit",
      "type": "string"
    },
    "Visuals": {
      "additionalProperties": false,
      "properties": {
        "color_roles": {
          "additionalProperties": {
            "items": {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            "type": "array"
          },
          "propertyNames": {
            "enum": [
              "input",
              "output",
              "moving",
              "fixed"
            ]
          },
          "title": "Color Roles",
          "type": "object"
        },
        "hero_params": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Hero Params",
          "type": "array"
        }
      },
      "required": [
        "hero_params"
      ],
      "title": "Visuals",
      "type": "object"
    }
  },
  "$id": "https://github.com/suchipizza/Junkyard/blob/main/schemas/brick.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actuation": {
      "anyOf": [
        {
          "$ref": "#/$defs/Actuation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "assembly_steps": {
      "items": {
        "type": "string"
      },
      "title": "Assembly Steps",
      "type": "array"
    },
    "bom": {
      "items": {
        "$ref": "#/$defs/BomLine"
      },
      "title": "Bom",
      "type": "array"
    },
    "category": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Category",
      "type": "string"
    },
    "derived": {
      "items": {
        "$ref": "#/$defs/Derived"
      },
      "title": "Derived",
      "type": "array"
    },
    "description_md": {
      "default": "README.md",
      "title": "Description Md",
      "type": "string"
    },
    "difficulty": {
      "$ref": "#/$defs/Difficulty"
    },
    "functions": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Functions",
      "type": "array"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_]*\\.[a-z0-9][a-z0-9_]*$",
      "title": "Id",
      "type": "string"
    },
    "license": {
      "$ref": "#/$defs/BrickLicense"
    },
    "mdi": {
      "$ref": "#/$defs/Mdi"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "outputs": {
      "description": "Named solids the generator returns.",
      "items": {
        "pattern": "^[a-z][a-z0-9_]*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Outputs",
      "type": "array"
    },
    "pairs_well_with": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]*\\.[a-z0-9][a-z0-9_]*$",
        "type": "string"
      },
      "title": "Pairs Well With",
      "type": "array"
    },
    "params": {
      "items": {
        "$ref": "#/$defs/Param"
      },
      "title": "Params",
      "type": "array"
    },
    "ports": {
      "items": {
        "$ref": "#/$defs/Port"
      },
      "title": "Ports",
      "type": "array"
    },
    "print_hints": {
      "anyOf": [
        {
          "$ref": "#/$defs/PrintHints"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "schema_version": {
      "enum": [
        "0.2.0"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "stage": {
      "$ref": "#/$defs/Stage"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "tags": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9_-]*$",
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "updated_at": {
      "format": "date",
      "title": "Updated At",
      "type": "string"
    },
    "visuals": {
      "$ref": "#/$defs/Visuals"
    }
  },
  "required": [
    "schema_version",
    "updated_at",
    "id",
    "name",
    "category",
    "stage",
    "summary",
    "functions",
    "mdi",
    "difficulty",
    "outputs",
    "visuals",
    "provenance"
  ],
  "title": "Junkyard brick manifest (brick.yaml)",
  "type": "object",
  "x-junkyard-schema-version": "0.2.0"
}
