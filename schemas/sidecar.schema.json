{
  "$comment": "Generated by `python -m junkyard.models.export`. Do not hand-edit.",
  "$id": "https://github.com/suchipizza/Junkyard/blob/main/schemas/sidecar.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Written next to every generated file as ``<file>.junkyard.json``.",
  "properties": {
    "brick": {
      "pattern": "^[a-z][a-z0-9_]*\\.[a-z0-9][a-z0-9_]*$",
      "title": "Brick",
      "type": "string"
    },
    "catalog_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Catalog Hash",
      "type": "string"
    },
    "file_format": {
      "enum": [
        "stl",
        "step",
        "glb"
      ],
      "title": "File Format",
      "type": "string"
    },
    "format": {
      "const": "junkyard.sidecar",
      "default": "junkyard.sidecar",
      "title": "Format",
      "type": "string"
    },
    "library_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+([.+-][0-9A-Za-z.+-]+)?$",
      "title": "Library Version",
      "type": "string"
    },
    "output": {
      "description": "Name of the solid in this file.",
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Output",
      "type": "string"
    },
    "params": {
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "title": "Params",
      "type": "object"
    },
    "schema_version": {
      "enum": [
        "0.2.0"
      ],
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "brick",
    "library_version",
    "catalog_hash",
    "params",
    "output",
    "file_format"
  ],
  "title": "Junkyard generated-file sidecar (<file>.junkyard.json)",
  "type": "object",
  "x-junkyard-schema-version": "0.2.0"
}
